    font-size: var(--fs-2xs);
    color: var(--color-text-muted);
    font-weight: var(--fw-normal);
  }

  /* --- 開閉式の問答 --------------------------------------------------- */
  .q {
    border-bottom: 1px solid var(--color-border);
  }
  .q > summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* タップ目標44px(掟:指で押せない導線は無いのと同じ) */
    min-height: 44px;
    padding: var(--space-3) 0;
    cursor: pointer;
    list-style: none;
  }
  .q > summary::-webkit-details-marker {
    display: none;
  }
  /* 開閉の向きを示す三角。CSSだけで描く(画像を足さない) */
  .q > summary::before {
    content: '';
    flex: none;
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: rotate(-45deg);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .q[open] > summary::before {
    transform: rotate(45deg);
  }
  .q > summary:hover h3 {
    color: var(--color-link);
  }
  .q > summary h3 {
    margin: 0;
    font-size: var(--fs-md);
  }
  .q .a {
    padding: 0 0 var(--space-4) calc(0.45em + var(--space-3));
  }
  .q p {
    margin: 0 0 var(--space-2);
    line-height: var(--lh-normal);
  }
  .q .a > :last-child {
    margin-bottom: 0;
  }
  .aside {
    font-size: var(--fs-sm);
  }
  .hint {
    display: block;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .notes {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }
  .src-intro {
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  .src-all > summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-size: var(--fs-sm);
    color: var(--color-link);
