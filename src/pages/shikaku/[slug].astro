---
/**
 * 資格詳細ページ。全300ページの原型。
 *
 * 構成は ADR-009 の決定に従う:
 *  - ベースは C案(ツール型)。ただし第1層(公式情報)は投稿がゼロでも単体で成立させる(ADR-007)
 *  - 本文は B案から移植した「受験者の疑問順」。各節は結論1文 → 数字 → 出典 で閉じる
 *  - サマリーは A案から移植したタイル + 推移チャート
 *  - **統計・公式情報は全てサーバ側で静的HTMLとして出力する。**JS に依存させない(ADR-009 必須要件)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceLink from '../../components/SourceLink.astro';
import StatTrendChart from '../../components/StatTrendChart.astro';
import RegionalStatsTable from '../../components/RegionalStatsTable.astro';
import PassingScoreTable from '../../components/PassingScoreTable.astro';
import StructuredData from '../../components/StructuredData.astro';
import StudyPaceTool from '../../components/StudyPaceTool.astro';
import ReportForm from '../../components/ReportForm.astro';
import StudyBoard from '../../components/StudyBoard.astro';
import RecentReports from '../../components/RecentReports.astro';
import NextExamBox from '../../components/NextExamBox.astro';
import TextbookList from '../../components/TextbookList.astro';
import PanelTabs from '../../components/PanelTabs.astro';
import SourceChip from '../../components/SourceChip.astro';
import DifficultyContext from '../../components/DifficultyContext.astro';
import { difficultyContext } from '../../lib/context';
import { guidesFor } from '../../lib/guides';
import CourseCta from '../../components/CourseCta.astro';
import { COURSE_LINKS } from '../../config';
import { getSnapshot } from '../../lib/reportSummary';
import {
  entities,
  statBlocks,
  seriesLabel,
  latestSeries,
  passRateTrend,
  sourceFor,
  type Entity,
} from '../../lib/entities';

export function getStaticPaths() {
  return entities.map((entity) => ({
    params: { slug: entity.slug },
    props: { entity },
  }));
}

interface Props {
  entity: Entity;
}
const { entity } = Astro.props;

const blocks = statBlocks(entity);
const primary = blocks[0];
const latest = primary ? latestSeries(primary.stats) : undefined;
const trend = primary ? passRateTrend(primary.stats) : null;

const num = new Intl.NumberFormat('ja-JP');

/**
 * 合格率は必ず小数第1位まで出す。
 * 34.0 をそのまま出すと「34%」になり、同じ列の「35.2%」と桁が揃わない。
 * 桁が不揃いだと、読み手には数値の精度が違うように見える。
 */
const pct = (v: number) => `${v.toFixed(1)}%`;

/** 合格率の幅。「例年どのくらいか」を1行で答えるために使う */
const rates = primary
  ? primary.stats.series.map((s) => s.pass_rate).filter((r): r is number => typeof r === 'number')
  : [];
const rateMin = rates.length ? Math.min(...rates) : null;
const rateMax = rates.length ? Math.max(...rates) : null;

/**
 * 統計ブロックが複数ある試験では、タイルの数字がどの系列のものかを必ず添える。
 *
 * タイルは先頭ブロックの数字しか出さない。ラベルが無いと、簿記なら統一試験の
 * 合格率がネット試験のものと読まれ、FPなら学科の合格率が実技にも当てはまると読まれる。
 * **どちらも「合算した数字」は存在しない。**存在しない数字を読者に想像させないための表示。
 */
const primaryLabel = blocks.length > 1 ? primary?.label : undefined;
const seriesWithLabel = (s: typeof latest) =>
  [s ? seriesLabel(s) : '', primaryLabel].filter(Boolean).join('・');

const title = `${entity.name}の合格率・受験者数データ`;
const description = latest
  ? `${entity.name}の公式統計。${seriesWithLabel(latest)}の受験者数は${num.format(latest.examinees ?? 0)}人、合格率は${(latest.pass_rate ?? 0).toFixed(1)}%。直近5年の推移と試験制度を実施団体の公表資料からまとめています。`
  : `${entity.name}の試験制度と公式統計をまとめています。`;

/**
 * 出典一覧。生URLの羅列は読者にとって何のページか分からないのでラベルを付ける。
 * 同じURLが複数項目の根拠になっている場合はラベルをまとめる。
 */
/**
 * 出典一覧に出す項目名。
 *
 * **未定義のキーを足すと、英語のキー名がそのまま読者に見える。**
 * 実際 `exemption` を追加したとき、出典一覧に「exemption」と表示されていた
 * ([CLAUDE.md](../../../../CLAUDE.md) 3-b: 造語・専門用語を対外文言に出さない)。
 * `source_urls` にキーを足すときは、必ずここにも日本語名を足すこと。
 */
const FIELD_LABELS: Record<string, string> = {
  eligibility: '受験資格',
  fee_yen: '受験手数料',
  fee_yen_cbt: '受験手数料(ネット試験)',
  format: '試験の形式',
  questions: '問題数',
  subjects: '試験科目',
  duration_minutes: '試験時間',
  passing_criteria: '合格基準',
  exemption: '科目免除',
  frequency: '実施頻度',
  result_announcement: '合格発表',
  license_requirement: '免許交付の要件',
};

const sourceMap = new Map<string, string[]>();
for (const [field, url] of Object.entries(entity.exam.source_urls ?? {})) {
  const label = FIELD_LABELS[field] ?? field;
  sourceMap.set(url, [...(sourceMap.get(url) ?? []), label]);
}
for (const block of blocks) {
  const label = blocks.length > 1 ? `${block.label}の統計` : '受験者数・合格率の統計';
  sourceMap.set(block.stats.source_url, [...(sourceMap.get(block.stats.source_url) ?? []), label]);
}
const uniqueSources = [...sourceMap.entries()].map(([url, labels]) => ({ url, labels: [...new Set(labels)] }));

const snapshot = getSnapshot(entity.slug);

/** この資格を扱う比較ページ。登録しないと孤立ページになる(src/lib/guides.ts) */
const relatedGuides = guidesFor(entity.slug);

/**
 * このページに講座リンク(広告)があるか。
 *
 * **CourseCta と同じ判定を使う。**片方だけ真になると、
 * 広告があるのに冒頭のPR表記が出ない(ステマ規制違反)か、
 * 広告が無いのにPR表記だけ出る(読者を無駄に警戒させる)状態になる。
 */
const hasAffiliate = (COURSE_LINKS[entity.slug] ?? []).length > 0;

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const canonical = new URL(Astro.url.pathname, origin).href;

/**
 * ページ内目次の項目。
 *
 * **実際に描画される節だけを載せる。**条件付きの節(都道府県別・合格点・テキスト)を
 * 無条件に並べると、押しても何も起きないリンクが目次に混ざる。
 * 各コンポーネント側の描画条件と、ここの条件は必ず一致させること。
 */
const hasSchedule = Boolean(entity.next_exam || entity.schedule_url);
const hasRegional = Boolean(
  entity.regional_stats && latest?.pass_rate !== null && latest?.pass_rate !== undefined,
);
const hasTextbooks = Boolean(entity.textbooks && entity.textbooks.items.length > 0);

/**
 * 冒頭の合格率に添える1行。
 *
 * **JSXの中で文字列を組み立てない。**改行やインデントがそのまま空白として出て、
 * 「令和7年度 ・例年 17〜18.7%」のように中黒の前に隙間ができる。
 */
const leadSub = [
  latest ? seriesWithLabel(latest) : '',
  rateMin !== null && rateMax !== null && rateMin !== rateMax ? `例年 ${rateMin}〜${rateMax}%` : '',
]
  .filter(Boolean)
  .join('・');

const diffCtx = difficultyContext(entity.slug);

/**
 * 2層目のタブ。
 *
 * **なぜ4つで、なぜこの切り方か**
 * 節を「データの種類」ではなく**読者の目的**でまとめる。
 * 以前の目次は「合格率の推移 / 合格点 / 都道府県別」と、
 * うちが持っているデータの名前を12個並べていた。
 * 読者は「合格点のデータ」を探しに来たのではなく、
 * 「受かるのか」「間に合うのか」を知りに来ている。
 *
 * hint に件数や日付を出して、**開く前に中身の見当がつく**ようにする。
 * ラベルだけのタブは、押してみるまで何があるか分からない。
 */
const panels = [
  {
    id: 'panel-data',
    label: '数字で見る',
    hint: `合格率・推移${hasRegional ? '・都道府県別' : ''}`,
  },
  {
    id: 'panel-prep',
    label: '受けるには',
    hint: entity.next_exam ? `次は ${entity.next_exam.date.slice(5, 10).replace('-', '/')}` : '日程・学習ペース',
  },
  { id: 'panel-people', label: 'みんなの記録', hint: '書き込み・合格報告' },
  { id: 'panel-rules', label: '制度と出典', hint: `試験のしくみ・出典${uniqueSources.length}件` },
];
---

<BaseLayout title={title} description={description} ogType="article" hasUserData={true} hasAffiliate={hasAffiliate}>
  <StructuredData slot="head" entity={entity} canonical={canonical} origin={origin} />

  {/*
    2026-07-27 レイアウトを作り替えた。

    それまでは13節が46remの1カラムに区切りなく積まれ、モバイル375px幅で
    **全長11,649px = 14.3画面**、しかもページ内の移動手段が1つも無かった。
    さらに節の順序が読者の目的と逆で、「宅建 合格率」で来た人が合格率の表に
    届くまで4,296px スクロールする必要があった。

    直したのは3つ。**追従する目次**を足し、**検索意図の順**に並べ替え、
    デスクトップでは**本文とレールの2カラム**にした。
  */}
  <div class="layout">
    <header class="pagehead">
      <nav class="crumbs" aria-label="パンくず">
        <a href="/">ホーム</a> <span aria-hidden="true">/</span>
        <span>{entity.category}</span> <span aria-hidden="true">/</span>
        <span aria-current="page">{entity.short_name}</span>
      </nav>

      <h1>{entity.name}</h1>
      <ul class="meta">
        <li>実施: <a href={entity.authority.url} rel="noopener">{entity.authority.name}</a></li>
        <li>{entity.category}</li>
      </ul>

      {/*
        **見出しの直後に数字を置く。**

        以前はここが「見出し → 説明のリード文2行 → 実施団体 → やっと数字」だった。
        このページに来る検索語は「◯◯ 合格率」であり、**答えを持っているのに
        自己紹介を先に読ませていた。**

        調査でも、民間のデータ訴求ページは要点の箱で数字を即出す型だった
        (studying.jp は見出し直下の箱に「合格点33点・合格率18.7%」を置いている)。
        逆に説明を先に置くのは、官公庁のように数字をPDFに預けているページである。

        リード文はここから下に降ろした。読む人は先に答えを受け取り、
        「これは何のページか」は数字を見た後で確かめればよい。
      */}
      {primary && latest && (
        <div class="keynums" id="summary">
          <div class="keynum keynum--lead">
            <span class="k-label">合格率</span>
            <span class="k-value">
              {latest.pass_rate !== null ? latest.pass_rate.toFixed(1) : '—'}<span class="k-unit">%</span>
            </span>
            {/*
              **合格率の幅は合格率の下に置く。**
              一度これを受験者数の下に置いてしまい、「245,462人 / 例年17〜18.7%」という
              数字と無関係な説明が並んだ。数字の直下の小さい字は、
              **その数字が何なのかを説明するもの**であって、別の指標を入れる場所ではない。
            */}
            <span class="k-sub">{leadSub}</span>
          </div>
          <div class="keynum">
            <span class="k-label">受験者数</span>
            <span class="k-value">{num.format(latest.examinees ?? 0)}<span class="k-unit">人</span></span>
            <span class="k-sub">{seriesLabel(latest)}</span>
          </div>
          {latest.passers !== null && (
            <div class="keynum">
              <span class="k-label">合格者数</span>
              <span class="k-value">{num.format(latest.passers)}<span class="k-unit">人</span></span>
              <span class="k-sub">{seriesLabel(latest)}</span>
            </div>
          )}
          {entity.next_exam && (
            <div class="keynum">
              <span class="k-label">次の試験日</span>
              <span class="k-value k-value--date">
                <time datetime={entity.next_exam.date}>{entity.next_exam.date.slice(0, 10).replace(/-/g, '/')}</time>
              </span>
              <span class="k-sub"><a href="#schedule">申込の締切を見る</a></span>
            </div>
          )}
        </div>
      )}

      <p class="lede">
        実施団体が公表している受験者数・合格率と、試験制度の要点をまとめています。
        数値はすべて出典を明記しています。利用者の投稿データは公式統計と混ぜていません。
      </p>
      {entity.authority_note && <p class="authority-note">{entity.authority_note}</p>}
    </header>

    {/*
      **ここから下が2層目。**

      1層目(上の pagehead)は常時表示で、検索で来た人の問いに答える数字だけを置く。
      2層目はタブで切り替える。縦に13画面積むのをやめた理由は長さではなく、
      **深い節が誰にも届かないから**である。書き込み欄はページ先頭から約6,000px
      (7画面目)にあり、検索で来た人がそこまでスクロールする理由が無かった。
      タブにすると、6,000px下にあった節が1画面目のラベルになる。
      隠すためではなく、届かせるために切り替える。
    */}
    <PanelTabs items={panels} />

    <article class="page">

    <div class="panel-group" data-panel id="panel-data">
      {/*
        **数字の直後に「で、それは難しいのか」を置く。**
        冒頭で合格率を大きく出しておきながら、このサイトはそれが難関を意味するのか
        どうかを一度も答えていなかった。比べる相手の無い数字は判断材料にならない。
      */}
      {diffCtx && (
        <DifficultyContext
          context={diffCtx}
          entityShortName={entity.short_name}
          currentSlug={entity.slug}
        />
      )}

    <div class="sec" data-source="official" id="stats">
    {blocks.map((block) => (
      <section class="stats" aria-labelledby={`h-${block.key}`}>
        <h2 id={`h-${block.key}`}>
          {blocks.length > 1 ? `${block.label}の受験者数と合格率` : '受験者数と合格率の推移'}
        </h2>

        {rateMin !== null && rateMax !== null && block.key === primary?.key && (
          <p class="finding">
            直近{block.stats.series.length}期の合格率は<strong>{rateMin}%〜{rateMax}%</strong>の範囲で推移しています。
            {trend && Math.abs(trend.diff) >= 1
              ? `直近は平均より${trend.diff > 0 ? '高め' : '低め'}です。`
              : '大きな変動はありません。'}
          </p>
        )}

        <StatTrendChart series={block.stats.series} />

        <div class="table-wrap">
          <table>
            <caption>{block.stats.unit}</caption>
            <thead>
              <tr>
                <th scope="col">{block.stats.series[0]?.session ? '回次' : '年度'}</th>
                <th scope="col" class="n">申込者数</th>
                <th scope="col" class="n">受験者数</th>
                <th scope="col" class="n">合格者数</th>
                <th scope="col" class="n">合格率</th>
              </tr>
            </thead>
            <tbody>
              {block.stats.series.map((s) => (
                <tr>
                  <th scope="row">
                    {seriesLabel(s)}
                    {s.date && <span class="date">{s.date}</span>}
                  </th>
                  <td class="n">{s.applicants !== null ? num.format(s.applicants) : '—'}</td>
                  <td class="n">{s.examinees !== null ? num.format(s.examinees) : '—'}</td>
                  <td class="n">{s.passers !== null ? num.format(s.passers) : '—'}</td>
                  <td class="n strong">{s.pass_rate !== null ? pct(s.pass_rate) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {block.stats.public_note && <p class="notes">{block.stats.public_note}</p>}

        <SourceLink
          href={block.stats.source_url}
          label={`${entity.authority.name} ${block.label}`}
          accessedAt={block.stats.retrieved_at}
        />
      </section>
    ))}
    </div>

    {entity.passing_score_history && (
      <div class="sec" data-source="official" id="scores">
        <PassingScoreTable history={entity.passing_score_history} entityShortName={entity.short_name} />
      </div>
    )}

    {hasRegional && entity.regional_stats && latest?.pass_rate != null && (
      <div class="sec" data-source="official" id="regional">
        <RegionalStatsTable
          regional={entity.regional_stats}
          entityShortName={entity.short_name}
          nationalRate={latest.pass_rate}
        />
      </div>
    )}
    </div>

    <div class="panel-group" data-panel id="panel-prep">
      {hasSchedule && (
        <div class="sec" data-source="official" id="schedule">
          <NextExamBox entity={entity} />
        </div>
      )}

      <div class="sec" data-source="tool" id="tool">
        <StudyPaceTool entityName={entity.short_name} snapshot={snapshot} />
      </div>

      {/*
        講座リンク(広告)。「準備する」のタブに置く。

        **P-006 の条件は、これで変わる。**(SATを8ページに置いてもクリックは出ない/判定日 8/27)
        2回のあいだ「実験中だから動かさない」と判断を先送りしてきたが、
        P-006 が0クリックを予測している理由は**流入がゼロだから**であって、置き場所ではない。
        流入が0のままなら、置き場所に関わらず結果は0になる。
        つまり位置を固定して守っていた情報は、初めから存在しない。
        レイアウトを人質にする理由が無いので動かし、P-006 には交絡を注記する。
      */}
      <CourseCta entitySlug={entity.slug} entityName={entity.short_name} />

      {hasTextbooks && (
        <div class="sec" data-source="reference" id="textbooks">
          <TextbookList entity={entity} />
        </div>
      )}
    </div>

    <div class="panel-group" data-panel id="panel-people">
      <div class="sec" data-source="user" id="board">
        <SourceChip kind="user" detail="登録不要・掲載前に機械判定" />
        <StudyBoard entitySlug={entity.slug} entityShortName={entity.short_name} />
      </div>

      {/*
        個別の合格報告は**1件目から**出す。統計値(中央値・分布)は20件まで出さない。
        この2つを混同して個別の報告まで隠していたのが、投稿が集まらない設計の原因だった。
      */}
      <div class="sec" data-source="user" id="report">
        <SourceChip kind="user" detail="合格した人の自己申告" sampleSize={snapshot.totalReports} />
        <RecentReports snapshot={snapshot} entityShortName={entity.short_name} />
        <ReportForm entitySlug={entity.slug} entityName={entity.short_name} />
      </div>
    </div>

    <div class="panel-group" data-panel id="panel-rules">

    <section class="qa sec" data-source="reference" id="faq" aria-labelledby="h-qa">
      <h2 id="h-qa">試験のしくみ</h2>

      {/*
        **開閉式にした理由**(2026-07-27)

        この節は7〜9問が全て開いた状態で 1,391px あり、ページ全体の12%を占めていた。
        しかも読者が実際に知りたい問いは1〜2個で、残りは通り過ぎるだけである。

        隠すことによる検索面の不利は無い。Google は隠しテキストの規定において
        「開閉するアコーディオン/タブのコンテンツ」を明示的に対象外としている:
        https://developers.google.com/search/docs/advanced/guidelines/hidden-text-links

        ただし**条件がある。中身がHTMLに実在すること。**
        JSで後から挿入する作りにすると、この免除は効かない。
        だからここは全てサーバ側で描画し、details の中に最初から入れておく。
        最初の1問だけ open にして、節が空に見えないようにする。
      */}
      <details class="q" open>
        <summary><h3>誰でも受験できますか</h3></summary>
        <div class="a">
          <p>{entity.exam.eligibility}</p>
          {sourceFor(entity, 'eligibility') && (
            <SourceLink href={sourceFor(entity, 'eligibility')!} label="受験資格(公式)" accessedAt={entity.exam.retrieved_at} />
          )}
        </div>
      </details>

      <details class="q">
        <summary><h3>どんな形式の試験ですか</h3></summary>
        <div class="a">
          <p>{entity.exam.format}</p>
          {sourceFor(entity, 'format') && (
            <SourceLink href={sourceFor(entity, 'format')!} label="試験の方法(公式)" accessedAt={entity.exam.retrieved_at} />
          )}
        </div>
      </details>

      <details class="q">
        <summary><h3>何点取れば合格ですか</h3></summary>
        <div class="a">
          <p>{entity.exam.passing_criteria}</p>
          {sourceFor(entity, 'passing_criteria') && (
            <SourceLink href={sourceFor(entity, 'passing_criteria')!} label="合格基準(公式)" accessedAt={entity.exam.retrieved_at} />
          )}
        </div>
      </details>

      {/*
        科目免除。**出典だけ載せて本文を出していなかった。**
        危険物乙4を持つ人が乙5・乙6を10問35分で受けられる、といった
        最も実用的な情報が読者に届いていなかった(出典一覧にだけ現れていた)。
      */}
      {entity.exam.exemption && (
        <details class="q">
          <summary><h3>免除される科目はありますか</h3></summary>
          <div class="a">
            <p>{entity.exam.exemption}</p>
            {sourceFor(entity, 'exemption') && (
              <SourceLink href={sourceFor(entity, 'exemption')!} label="科目免除(公式)" accessedAt={entity.exam.retrieved_at} />
            )}
          </div>
        </details>
      )}

      {/*
        試験に受かっても免許が交付されない資格がある(二級ボイラー技士)。
        受験を決める前に知る必要がある情報なので、独立した問いとして出す。
      */}
      {entity.exam.license_requirement && (
        <details class="q">
          <summary><h3>合格すれば免許はもらえますか</h3></summary>
          <div class="a">
            <p>{entity.exam.license_requirement}</p>
            {entity.exam.license_requirement_note && (
              <p class="aside"><span class="hint">{entity.exam.license_requirement_note}</span></p>
            )}
            {sourceFor(entity, 'license_requirement') && (
              <SourceLink href={sourceFor(entity, 'license_requirement')!} label="免許交付の要件(公式)" accessedAt={entity.exam.retrieved_at} />
            )}
          </div>
        </details>
      )}

      {entity.exam.subjects && entity.exam.subjects.length > 0 && (
        <details class="q">
          <summary><h3>どんな科目が出ますか</h3></summary>
          <div class="a">
            <ul class="subjects">
              {entity.exam.subjects.map((s) => <li>{s}</li>)}
            </ul>
            {sourceFor(entity, 'subjects') && (
              <SourceLink href={sourceFor(entity, 'subjects')!} label="試験科目(公式)" accessedAt={entity.exam.retrieved_at} />
            )}
          </div>
        </details>
      )}

      <details class="q">
        <summary><h3>いつ受験できますか</h3></summary>
        <div class="a">
          <p>{entity.exam.frequency}</p>
          {entity.schedule_url && (
            <p class="aside">
              <a href={entity.schedule_url} rel="noopener">試験日程の確認ページ</a>
              {entity.schedule_url_note && <span class="hint">{entity.schedule_url_note}</span>}
            </p>
          )}
        </div>
      </details>

      <details class="q">
        <summary><h3>合否はいつ、どう分かりますか</h3></summary>
        <div class="a">
          <p>{entity.exam.result_announcement}</p>
          {sourceFor(entity, 'result_announcement') && (
            <SourceLink href={sourceFor(entity, 'result_announcement')!} label="合格発表(公式)" accessedAt={entity.exam.retrieved_at} />
          )}
        </div>
      </details>

      {entity.exam.fee_yen !== null && (
        <details class="q">
          <summary><h3>費用はいくらかかりますか</h3></summary>
          <div class="a">
            <p>
              受験手数料は{num.format(entity.exam.fee_yen)}円です。
              {entity.exam.fee_note}
            </p>
            {sourceFor(entity, 'fee_yen') && (
              <SourceLink href={sourceFor(entity, 'fee_yen')!} label="受験手数料(公式)" accessedAt={entity.exam.retrieved_at} />
            )}
          </div>
        </details>
      )}
    </section>

    {relatedGuides.length > 0 && (
      <section class="guides sec" data-source="reference" aria-labelledby="h-guides">
        <h2 id="h-guides">ほかの区分と比べる</h2>
        <ul>
          {relatedGuides.map((g) => (
            <li>
              <a href={g.path}>{g.title}</a>
              <p>{g.blurb}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/*
      **出典の一覧を畳む(2026-07-28)。**

      ここは生URLの羅列で492pxあった。しかし**出典はすでに各節の中に
      個別に置かれている**(SourceLink)。読者が「この数字の根拠は」と思ったとき
      見るのは、その数字のすぐ下の出典であって、ページ末尾の一覧ではない。

      一覧そのものは残す。全部まとめて確認したい人と、
      掲載方針を検めたい人のためにある。ただし既定で開いておく必要はない。
      折りたたんでも中身はHTMLに実在するので、検索面での扱いは変わらない
      (Google の隠しテキスト規定はアコーディオンを明示的に対象外としている)。
    */}
    <section class="sources sec" data-source="reference" id="sources" aria-labelledby="h-sources">
      <h2 id="h-sources">このページの出典</h2>
      <p class="src-intro">
        掲載している数値と制度の説明は、すべて実施団体の公表資料にもとづいています。
        取得日は{entity.exam.retrieved_at}です。試験制度は改定されることがあるため、
        <strong>出願前には必ず実施団体の最新の案内を確認してください。</strong>
      </p>
      <details class="src-all">
        <summary>出典{uniqueSources.length}件をまとめて見る</summary>
      <ul>
        {uniqueSources.map(({ url, labels }) => (
          <li>
            <span class="src-labels">{labels.join(' / ')}</span>
            <a href={url} rel="noopener nofollow">{url}</a>
          </li>
        ))}
      </ul>
      </details>
      {entity.public_note && <p class="notes">{entity.public_note}</p>}
    </section>
    </div>
    </article>
  </div>
</BaseLayout>

<style>
  /*
   * ============================================================
   * 1カラム。全ての画面幅で。
   * ============================================================
   * ここには以前「本文44rem + 追従レール13rem」の2カラムグリッドがあった。
   * 目次をレールに置いていた頃の名残である。
   *
   * **2026-07-28 に目次をタブへ差し替えたとき、このCSSを消し忘れた。**
   * `<aside class="rail">` を消して `<PanelTabs>` を置いたので、
   * タブが自動配置で**右のレール列(13rem)に落ちた。**
   * 横一列で置くはずのタブが縦に積まれ、`white-space: nowrap` と
   * `overflow-x: auto` によってラベルが「みノ」「書き」と切れた状態で
   * 本番に出た(オーナーの画面で発覚)。
   *
   * **原因は消し忘れそのものより、確認の穴である。**
   * タブ化の後、375px でしか実測せず、デスクトップ幅を一度も見ていなかった。
   * レイアウトを変えたら、**切り替わる境界の両側を必ず見ること。**
   *
   * タブは本文の上に横一列で置くものなので、レール列そのものが要らない。
   */
  .layout {
    display: block;
    /* 本文の測定幅。日本語は1行40〜45字を超えると次の行の頭を見失いやすい */
    max-width: 46rem;
    margin-inline: auto;
  }

  .page {
    min-width: 0;
  }

  .pagehead {
    margin-bottom: var(--space-4);
  }

  /*
   * 節の区切り。
   *
   * 以前は全13節が同じ余白で並び、どこで話題が変わったのか分からなかった。
   * 見出しの文字サイズだけでは、14画面ぶんスクロールする読者に切れ目は伝わらない。
   * 節の頭に余白と細い罫線を入れて、視覚的な段落として立てる。
   */
  .sec {
    scroll-margin-top: 4.5rem;
  }
  /*
   * **面が区切りを担うので、罫線と余白を返す。**
   *
   * 以前は節と節の間が margin 64px + padding 32px + 罫線 = 96px あり、
   * 10節ぶんで 960px を区切りだけに使っていた。しかも全節が同じ白い箱だったので、
   * その96pxが唯一の区切りだった。
   * いまは出所ごとに面の色が変わるため、隣り合う節は色の違いで分かれる。
   * 二重に区切る必要はない。
   */
  .sec + .sec,
  .sec + :global(section) {
    margin-top: var(--space-5);
  }
  /* 面を持たない節どうしが隣り合うときだけ、罫線で切る */
  .sec[data-source='reference'] + .sec[data-source='reference'] {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--border-thin);
  }
  /*
   * ここには「64rem 以上ではレールに目次が出るので逃げが要らない」という
   * 上書きがあったが、レールごと廃止した。
   * タブは全ての幅で上端に貼り付くので、逃げは常に必要である。
   */

  .crumbs {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .pagehead h1 {
    font-size: var(--fs-2xl);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-2);
  }
  /*
   * リード文は数字より下。**大きさも本文より落とす。**
   * ここはページの自己紹介であって、読者が探しに来たものではない。
   */
  .lede {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    margin: var(--space-5) 0 0;
  }

  /* --- 冒頭の要点(数字を最初の1画面に出す) --------------------------- */
  .keynums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1px;
    margin-top: var(--space-5);
    /*
     * 罫線を「隙間」で描く。枠を1つずつ持たせると、
     * 既に箱だらけのページに箱がもう4つ増える。
     */
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-official);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .keynum {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
  }
  /* 合格率だけは一段大きい。このページで最も検索されている数字である */
  .keynum--lead {
    grid-column: span 2;
  }
  .k-label {
    font-size: var(--fs-2xs);
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
  }
  .k-value {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .keynum--lead .k-value {
    font-size: var(--fs-3xl);
    color: var(--color-official-strong);
  }
  .k-value--date {
    font-size: var(--fs-lg);
  }
  .k-unit {
    font-size: var(--fs-sm);
    font-weight: var(--fw-normal);
    margin-left: 0.1em;
    color: var(--color-text-muted);
  }
  .k-sub {
    font-size: var(--fs-2xs);
    color: var(--color-text-muted);
  }
  .meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .authority-note {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    background: var(--color-notice-bg);
    border-left: 3px solid var(--color-notice-border);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  /*
   * 節どうしの間隔は .sec + .sec が持つ。
   * ここでは #stats の中に複数の統計ブロック(統一試験 / ネット試験など)が
   * 並ぶ場合の、ブロック間の間隔だけを見る。
   */
  .stats + .stats {
    margin-top: var(--space-7);
  }
  h2 {
    font-size: var(--fs-xl);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-3);
  }
  h3 {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-2);
  }


  .finding {
    color: var(--color-text);
    background: var(--color-official-bg);
    border-left: 3px solid var(--color-official);
    padding: var(--space-3) var(--space-4);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }



  /* 公式統計は左罫線で出所を示す。ユーザー投稿は別色・破線にして混同を防ぐ */






  .table-wrap {
    overflow-x: auto;
    margin: var(--space-4) 0 var(--space-3);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  caption {
    text-align: left;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    padding-bottom: var(--space-2);
  }
  th,
  td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }
  thead th {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    font-weight: var(--fw-medium);
  }
  .n {
    text-align: right;
