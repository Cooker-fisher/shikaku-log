---
/**
 * 404ページ。
 *
 * **これが無いと Cloudflare Pages は存在しないURLに index.html を 200 で返す。**
 * 実際に2026-07-25の公開直後にその状態が発生していた(/aaaa/bbbb のような
 * 出鱈目なURLがトップページの内容を200で返していた)。
 * Googleは無限に重複ページをインデックスし、ソフト404としてサイト全体の評価を下げる。
 * `dist/404.html` が存在すると Pages はこれを 404 ステータスで返す。
 *
 * 公開後は `scripts/smoke.mjs` で存在しないURLが404を返すことを毎回確認する。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { entities, statBlocks, latestSeries } from '../lib/entities';

const num = new Intl.NumberFormat('ja-JP');

const cards = entities
  .map((entity) => {
    const block = statBlocks(entity)[0];
    return { entity, latest: block ? latestSeries(block.stats) : undefined };
  })
  .sort((a, b) => (b.latest?.examinees ?? 0) - (a.latest?.examinees ?? 0));
---

<BaseLayout
  title="ページが見つかりません"
  description="お探しのページは見つかりませんでした。シカクログは資格試験の受験者数・合格率を実施団体の公表資料からまとめたサイトです。掲載中の資格の一覧から探せます。"
  noindex={true}
>
  <div class="prose stack">
    <h1>ページが見つかりません</h1>

    <p>
      お探しのページは存在しないか、移動した可能性がある。
      URLの入力間違いでなければ、こちらの手違いかもしれない。
      <a href="/contact/">お問い合わせ</a>から知らせてもらえると助かる。
    </p>

    <h2>掲載中の資格</h2>

    <ul class="shikaku-list">
      {cards.map(({ entity, latest }) => (
        <li>
          <a href={`/shikaku/${entity.slug}/`} class="shikaku-link">
            <span class="shikaku-name">{entity.name}</span>
            <span class="shikaku-cat">{entity.category}</span>
          </a>
          {latest && (
            <dl class="shikaku-stats">
              <div>
                <dt>受験者数</dt>
                <dd class="num">{num.format(latest.examinees ?? 0)}人</dd>
              </div>
              <div>
                <dt>合格率</dt>
                <dd class="num">{latest.pass_rate}%</dd>
              </div>
            </dl>
          )}
        </li>
      ))}
    </ul>

    <p>
      掲載する資格は順次増やしている。方針は<a href="/about/">このサイトについて</a>に書いている。
      <a href="/">トップページ</a>からも探せる。
    </p>
  </div>
</BaseLayout>

<style>
  .shikaku-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .shikaku-list > li {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-official);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--color-surface);
  }
  .shikaku-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }
  .shikaku-name {
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--color-link);
  }
  .shikaku-link:hover .shikaku-name {
    text-decoration: underline;
  }
  .shikaku-cat {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .shikaku-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-3) 0 0;
  }
  .shikaku-stats > div {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .shikaku-stats dt {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .shikaku-stats dd {
    margin: 0;
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
  }
</style>
