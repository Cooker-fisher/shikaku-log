---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, MIN_SAMPLE_SIZE } from '../config';
import { entities, statBlocks, latestSeries, seriesLabel } from '../lib/entities';

const num = new Intl.NumberFormat('ja-JP');

// 受験者数の多い順に並べる。孤立ページを作らないため全資格をここから必ずリンクする。
const cards = entities
  .map((entity) => {
    const block = statBlocks(entity)[0];
    return { entity, latest: block ? latestSeries(block.stats) : undefined };
  })
  .sort((a, b) => (b.latest?.examinees ?? 0) - (a.latest?.examinees ?? 0));

const title = `${SITE_NAME} — 資格の受験者数・合格率と合格報告のデータベース`;
const description =
  '資格試験の受験者数・合格率の推移と試験日程を公式発表から集約し、合格者の自己申告データ(勉強時間・使用教材)を併せて掲載するデータベース。';
---

<BaseLayout title={title} description={description}>
  {/*
    2026-07-26 全面改稿。
    それまでのトップは「掲載する3つの層」「数字の扱い方」という**運営方針の説明**が主役で、
    資格一覧はページ最下部、投稿導線に至っては1つも無かった。
    投稿してもらうサイトなのに、最重要の行動が画面に存在していなかった。

    方針の説明は削らない(誠実さはこのサイトの資産である)。主役から降ろすだけにする。
  */}
  <div class="prose stack">
    <h1>資格の数字を、出典つきで1ページに</h1>

    <p class="lede">
      受験者数・合格率・試験日程を、実施団体の公表資料から資格ごとに集約している。
      掲載する数値には必ず公式発表のURLと取得日を添える。
    </p>

    <h2 id="shikaku">資格を選ぶ</h2>

    <ul class="shikaku-list">
      {cards.map(({ entity, latest }) => (
        <li>
          <a href={`/shikaku/${entity.slug}/`} class="shikaku-link">
            <span class="shikaku-name">{entity.name}</span>
            <span class="shikaku-cat">{entity.category}</span>
          </a>
          {latest && (
            <dl class="shikaku-stats">
              <div>
                <dt>受験者数</dt>
                <dd class="num">{num.format(latest.examinees ?? 0)}人</dd>
              </div>
              <div>
                <dt>合格率</dt>
                <dd class="num">{latest.pass_rate}%</dd>
              </div>
              <div>
                <dt>集計</dt>
                <dd class="muted">{seriesLabel(latest)}</dd>
              </div>
            </dl>
          )}
          <p class="shikaku-actions">
            <a class="btn btn-primary" href={`/shikaku/${entity.slug}/#report`}>
              合格報告を送る
            </a>
            <a class="btn btn-quiet" href={`/shikaku/${entity.slug}/`}>データを見る</a>
          </p>
        </li>
      ))}
    </ul>

    <p class="note">
      掲載する資格は順次増やしている。実施団体の公表資料で数値を確認できたものだけを載せている。
    </p>

    <section class="invite" aria-labelledby="h-invite">
      <h2 id="h-invite">合格した人へ</h2>
      <p>
        勉強時間・受験回数・使った教材を送ってほしい。入力は<strong>3項目・30秒</strong>で終わる。
        名前もメールアドレスも要らない。
      </p>
      <p>
        これから受ける人が知りたいのは「実際どれくらいやったか」で、
        それは公式発表には載っていない。<strong>合格した人しか持っていない情報</strong>である。
      </p>
      <p class="note">
        送られたデータは<strong>自己申告に基づく</strong>もので、公的な統計ではない。
        掲載時は件数を必ず併記し、公式統計とは別の枠で表示する。
      </p>
      <p class="invite-actions">
        {cards.map(({ entity }) => (
          <a class="btn btn-primary" href={`/shikaku/${entity.slug}/#report`}>
            {entity.short_name}の合格報告を送る
          </a>
        ))}
      </p>
    </section>

    <h2>数字の扱い方</h2>

    <p>
      投稿データの集計は、有効回答が<span class="num">{MIN_SAMPLE_SIZE}</span>件に達するまで
      中央値も分布も順位も表示しない。数件しかない状態の中央値は、投稿が1件増えるだけで大きく動く。
      その数字を見せることは、読む人に誤った基準を渡すことになる。
      閾値の判定は集計ロジック側で強制していて、表示側が独自に緩めることはできない。
    </p>

    <p>
      ただし<strong>個々の合格報告は1件目から掲載する</strong>。
      「何時間で受かったか」という1人の記録は、集計値ではないので誤解を生まない。
      統計として出せる数と、人の記録として出せる数は別に扱う。
    </p>

    <p>
      公式統計についても同じ姿勢を取る。公表されていない年度は空欄にし、
      「おそらくこの程度」という補間はしない。
      掲載方針の詳細は<a href="/about/">このサイトについて</a>に書いている。
    </p>
  </div>
</BaseLayout>

<style>
  .shikaku-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .shikaku-list > li {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-official);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--color-surface);
  }
  .shikaku-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }
  .shikaku-name {
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--color-link);
  }
  .shikaku-link:hover .shikaku-name {
    text-decoration: underline;
  }
  .shikaku-cat {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .shikaku-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-3) 0 0;
  }
  .shikaku-stats > div {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .shikaku-stats dt {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .shikaku-stats dd {
    margin: 0;
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
  }
  .shikaku-stats dd.muted {
    font-weight: var(--fw-normal);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .lede {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }
  .note {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  /*
   * タップ目標は最低44px。スマホで押せない導線は無いのと同じ。
   * 2026-07-26の実測では24リンク中22が44px未満だった。
   */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    text-decoration: none;
  }
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border: 1px solid var(--color-primary);
  }
  .btn-quiet {
    background: transparent;
    color: var(--color-link);
    border: 1px solid var(--color-border-strong);
  }
  .shikaku-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
  }

  .invite {
    margin-top: var(--space-7);
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-userdata);
    border-radius: var(--radius-md);
    background: var(--color-userdata-bg);
  }
  .invite h2 {
    margin-top: 0;
  }
  .invite p {
    line-height: var(--lh-normal);
  }
  .invite-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: 0;
  }
</style>
