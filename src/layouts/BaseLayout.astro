---
/**
 * 全ページの原型。head の中身(title / description / canonical / OGP)は
 * ここでしか組み立てない。qa.mjs がこの出力を検査する。
 */
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE, NAV_LINKS, FOOTER_LINKS, GA_MEASUREMENT_ID } from '../config';

interface Props {
  title: string;
  description: string;
  /** true にすると noindex。下書き・重複ページ用 */
  noindex?: boolean;
  /** アフィリエイトリンクを含むページ(PR表記を強制する) */
  hasAffiliate?: boolean;
  /** ユーザー投稿データを表示するページ(自己申告の注記を強制する) */
  hasUserData?: boolean;
  ogType?: 'website' | 'article';
  /**
   * 本文 + 追従レールの2カラムを組むページ。
   * 既定の 64rem では、レールを出すと本文が読みにくい幅まで痩せる。
   */
  wide?: boolean;
}

const {
  title,
  description,
  noindex = false,
  hasAffiliate = false,
  hasUserData = false,
  ogType = 'website',
  wide = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | ${SITE_NAME}`;
/** SNS共有カード用の画像。**絶対URLでなければSNS側が解決できない** */
const ogImage = new URL('/og.png', Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {/*
      og:image が無いまま twitter:card=summary_large_image を指定していた(〜2026-07-26)。
      画像必須のカード形式で画像が無いと、SNS共有時に空白のカードになる。
      指定しないより悪い状態を2日間放置していた。
    */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — 資格の受験者数・合格率を出典つきでまとめるデータベース`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <slot name="head" />

    {/* GA4。本番のみ読み込む。プレビュー/ローカルの数字が混ざると
        週次の意思決定(構築ループ)が狂うため、ホスト名で判定する。 */}
    {GA_MEASUREMENT_ID && (
      <>
        <script
          type="text/partytown-ignore"
          is:inline
          define:vars={{ GA_MEASUREMENT_ID }}
          set:html={`
            if (location.hostname === 'shikaku-log.com') {
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              function gtag(){ dataLayer.push(arguments); }
              window.gtag = gtag;
              gtag('js', new Date());
              gtag('config', GA_MEASUREMENT_ID);
            }
          `}
        />
      </>
    )}
  </head>
  <body data-has-affiliate={hasAffiliate ? 'true' : 'false'} data-has-user-data={hasUserData ? 'true' : 'false'}>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">{SITE_NAME}</a>
        <span class="sample-size">{SITE_TAGLINE}</span>
        <nav class="site-nav" aria-label="メインナビゲーション">
          {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <div class={wide ? 'container container--wide' : 'container'}>
        {/*
          広告を含むページでは**本文の冒頭**にPR表記を出す。
          ステマ規制が求めるのは「広告であることが一般消費者にとって明瞭であること」であり、
          ページ下部の広告枠の中に書いてあるだけでは、そこまで到達しない読者には伝わらない。
          2026-07-26、最初のアフィリエイトリンクを入れる直前にQAが
          「PR表記が本文の1030文字目」と検出したため追加した。
        */}
        {hasAffiliate && (
          <p class="pr-top" data-pr-disclosure>
            <span class="pr-top__badge">PR</span>
            このページには広告(アフィリエイトリンク)が含まれます。
            リンク経由の申し込みで運営者に報酬が支払われますが、
            掲載している公式統計と投稿データの内容は広告の有無で変えていません。
          </p>
        )}
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav aria-label="フッターナビゲーション">
          <ul>
            {FOOTER_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </nav>
        <p>
          掲載している公式統計は各実施団体の公表資料にもとづく。出典URLは各ページに記載する。
        </p>
        <p>&copy; {new Date().getFullYear()} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>
