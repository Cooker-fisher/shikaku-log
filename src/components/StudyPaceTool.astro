---
/**
 * 学習ペースの逆算ツール。ADR-009 で採用した C案の核心。
 *
 * 設計の要点:
 * - **投稿がゼロでも動く。** 他人のデータを必要とせず、利用者自身の目標と試験日だけで
 *   1日あたりの必要時間を返す。これが n=0 の期間を橋渡しする唯一の実用機能(ADR-007)
 * - 投稿が MIN_SAMPLE_SIZE 件集まったら「合格者の中央値」を目標値の候補として追加する。
 *   **集まるまでは中央値を出さない。**存在しない標準をこちらで捏造しない
 * - JS はこのツールの対話部分だけ。ページの情報価値(統計・制度)は静的HTMLにある
 */
import { MIN_SAMPLE_SIZE } from '../config';
import type { ReportSnapshot } from '../lib/reportSummary';

interface Props {
  entityName: string;
  snapshot: ReportSnapshot;
}
const { entityName, snapshot } = Astro.props;

const ready = snapshot.studyHours.status === 'ready';
const median = snapshot.studyHours.median;
const n = snapshot.studyHours.sampleSize;
---

<section class="tool" aria-labelledby="h-tool">
  <h2 id="h-tool">学習ペースを逆算する</h2>

  <p class="intro">
    試験日と、1日に使える時間を入れると、<strong>試験日までに合計何時間ぶん積めるか</strong>を計算します。
    {ready
      ? `合格報告${n}件の中央値は${median}時間です。積める時間がそれに届くかも判定します。`
      : '「何時間必要か」は人によって違い、公式にも発表されていません。まず自分が積める量を知るための計算です。'}
  </p>

  <form class="pace" id="pace-form" novalidate>
    <div class="field">
      <label for="pace-date">試験日</label>
      <input type="date" id="pace-date" name="date" required />
    </div>

    <div class="field">
      <label for="pace-weekday">平日1日に使える時間</label>
      <div class="with-unit">
        <input type="number" id="pace-weekday" name="weekday" min="0" max="14" step="0.5" inputmode="decimal" placeholder="1" required />
        <span class="unit">時間</span>
      </div>
      <p class="hint">通勤中や昼休みを含めて構いません。</p>
    </div>

    <div class="field">
      <label for="pace-weekend">休日1日に使える時間</label>
      <div class="with-unit">
        <input type="number" id="pace-weekend" name="weekend" min="0" max="14" step="0.5" inputmode="decimal" placeholder="3" required />
        <span class="unit">時間</span>
      </div>
    </div>

    <div class="field">
      <label for="pace-target">目標の総学習時間(任意)</label>
      <div class="with-unit">
        <input type="number" id="pace-target" name="target" min="1" max="5000" step="10" inputmode="numeric" placeholder="未入力可" />
        <span class="unit">時間</span>
      </div>
      <p class="hint">
        {ready
          ? '入れると、積める時間で足りるかを判定します。'
          : '決まっていなければ空のままで構いません。目標を知るために来た人に、目標を入力させないための任意項目です。'}
      </p>
      {ready && (
        <button type="button" class="chip" id="use-median" data-median={median}>
          合格報告の中央値({median}時間)を使う
        </button>
      )}
    </div>

    <button type="submit" class="submit">計算する</button>
  </form>

  <output id="pace-result" class="result" hidden aria-live="polite"></output>

  <noscript>
    <p class="notes">
      この計算にはJavaScriptが必要です。無効の場合でも、このページの公式統計と試験制度の情報はすべて表示されています。
    </p>
  </noscript>

  {/*
    **「公開ラインまであと◯件」のカウンタは撤去した(ADR-016)。**
    集計を{MIN_SAMPLE_SIZE}件まで出さない判断自体は統計的に正しいので維持する。
    しかし進捗ゲージは、投稿の対価を「他人が先に19人来ること」に条件づけており、
    1人目にとっては報酬がゼロであることを可視化していた。
    第三者レビューでも「0件を3か所で告知しており、空席を照明で照らしている」と指摘された。
    非表示の理由だけを静かに書き、件数の不足は数えて見せない。
  */}
  {!ready && (
    <div class="collecting" data-user-data-note>
      <p class="why">
        合格した人の勉強時間は公式に発表されていないため、このサイトでは利用者の報告を集めています。
        ただし中央値や分布は、報告が{MIN_SAMPLE_SIZE}件に達するまで表示しません。
        数件しかない状態の中央値は、報告が1件増えるだけで大きく動きます。
        その数字が「{entityName}の相場」として一人歩きすると、かえって判断を誤らせるためです。
        集計データは利用者の自己申告にもとづくもので、公的な統計ではありません。
      </p>
    </div>
  )}
</section>

<script>
  const form = document.getElementById('pace-form');
  const result = document.getElementById('pace-result');

  if (form && result) {
    const medianBtn = document.getElementById('use-median');
    const targetInput = document.getElementById('pace-target');

    if (medianBtn && targetInput) {
      medianBtn.addEventListener('click', () => {
        targetInput.value = medianBtn.dataset.median ?? '';
        targetInput.focus();
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const dateValue = form.querySelector('#pace-date').value;
      const weekday = Number(form.querySelector('#pace-weekday').value);
      const weekend = Number(form.querySelector('#pace-weekend').value);
      const targetRaw = form.querySelector('#pace-target').value;
      const target = targetRaw === '' ? null : Number(targetRaw);

      const show = (html, tone) => {
        result.innerHTML = html;
        result.dataset.tone = tone;
        result.hidden = false;
      };

      if (!dateValue || !Number.isFinite(weekday) || !Number.isFinite(weekend)) {
        show('<p class="err">試験日と、平日・休日に使える時間を入力してください。</p>', 'error');
        return;
      }
      if (weekday < 0 || weekend < 0) {
        show('<p class="err">使える時間に負の数は入れられません。</p>', 'error');
        return;
      }
      // 上限は「1日24時間」ではなく人間が確保できる量で切る(掟 3-8)。
      // 睡眠・食事・移動を除くと、専業でも持続可能なのは1日10〜12時間が限界。
      const MAX_FEASIBLE_HOURS_PER_DAY = 14;
      if (weekday > MAX_FEASIBLE_HOURS_PER_DAY || weekend > MAX_FEASIBLE_HOURS_PER_DAY) {
        show(
          `<p class="err">1日に使える時間は${MAX_FEASIBLE_HOURS_PER_DAY}時間までで入力してください。睡眠や生活の時間を考えると、それ以上を続けるのは現実的ではありません。</p>`,
          'error',
        );
        return;
      }
      if (weekday === 0 && weekend === 0) {
        show('<p class="err">平日か休日のどちらかに、使える時間を入れてください。</p>', 'error');
        return;
      }

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const examDate = new Date(dateValue + 'T00:00:00');
      const days = Math.ceil((examDate.getTime() - today.getTime()) / 86400000);

      if (days <= 0) {
        show('<p class="err">試験日は今日より後の日付を入れてください。</p>', 'error');
        return;
      }

      // 今日から試験日前日までの平日・休日を実際に数える。
      // 「日数÷7×5」で概算すると、試験日が日曜(資格試験に多い)のとき
      // 休日の数が1〜2日ずれ、積算時間が数時間単位で変わる。
      let weekdayCount = 0;
      let weekendCount = 0;
      const cursor = new Date(today);
      for (let i = 0; i < days; i += 1) {
        cursor.setDate(cursor.getDate() + 1);
        const dow = cursor.getDay();
        if (dow === 0 || dow === 6) weekendCount += 1;
        else weekdayCount += 1;
      }

      const totalHours = weekdayCount * weekday + weekendCount * weekend;
      const perWeek = weekday * 5 + weekend * 2;

      const fmt = (h) => (h >= 10 ? Math.round(h).toLocaleString('ja-JP') : h.toFixed(1));

      let verdict = '';
      let tone = 'ok';
      if (target !== null && Number.isFinite(target) && target > 0) {
        const diff = totalHours - target;
        if (diff >= 0) {
          verdict = `<p class="sub">目標の ${target.toLocaleString('ja-JP')} 時間に対して <strong>${fmt(diff)}時間の余裕</strong>があります。</p>`;
          tone = 'ok';
        } else {
          const needPerDay = target / days;
          verdict =
            `<p class="sub">目標の ${target.toLocaleString('ja-JP')} 時間には <strong>${fmt(-diff)}時間足りません</strong>。` +
            `届かせるには1日平均 ${needPerDay.toFixed(1)} 時間が必要です。</p>`;
          tone = 'warn';
        }
      }

      show(
        `<p class="lead">試験日まで <strong>${days}日</strong>(平日${weekdayCount}日・休日${weekendCount}日)。
           このペースなら合計 <strong>${fmt(totalHours)}時間</strong> 積めます。</p>
         <p class="sub">1週間あたり ${fmt(perWeek)} 時間の計算です。</p>
         ${verdict}`,
        tone,
      );
    });
  }
</script>

<style>
  .tool {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-4);
    background: var(--color-bg-subtle);
  }
  .intro {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-4);
  }
  .pace {
    display: grid;
    gap: var(--space-4);
  }
  .field {
    display: grid;
    gap: var(--space-2);
  }
  label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }
  input {
    font: inherit;
    font-variant-numeric: tabular-nums;
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    width: 100%;
    min-height: 44px;
  }
  input:focus-visible {
    outline: 2px solid var(--color-official);
    outline-offset: 1px;
  }
  .with-unit {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .unit {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .chip {
    justify-self: start;
    font: inherit;
    font-size: var(--fs-xs);
    padding: var(--space-2) var(--space-3);
    min-height: 36px;
    border: 1px dashed var(--color-userdata);
    color: var(--color-userdata-strong);
    background: var(--color-userdata-bg);
    border-radius: 999px;
    cursor: pointer;
  }
  .submit {
    font: inherit;
    font-weight: var(--fw-bold);
    padding: var(--space-3) var(--space-5);
    min-height: 48px;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    cursor: pointer;
  }
  .submit:hover {
    background: var(--color-link-hover);
  }

  .result {
    display: block;
    margin-top: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--color-official);
    background: var(--color-official-bg);
  }
  .result[data-tone='error'] {
    border-left-color: var(--c-danger-500);
    background: transparent;
  }
  .result[data-tone='warn'],
  .result[data-tone='tight'] {
    border-left-color: var(--color-notice-border);
    background: var(--color-notice-bg);
  }
  .result :global(.lead) {
    margin: 0;
    font-size: var(--fs-lg);
    line-height: var(--lh-heading);
  }
  .result :global(.lead strong) {
    font-variant-numeric: tabular-nums;
  }
  .result :global(.sub) {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .result :global(.err) {
    margin: 0;
    font-size: var(--fs-sm);
  }

  .collecting {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px dashed var(--color-userdata);
  }
  .collecting h3 {
    font-size: var(--fs-md);
    margin: 0 0 var(--space-2);
  }
  .gauge-label {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  .gauge {
    height: 8px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
  }
  .gauge span {
    display: block;
    height: 100%;
    background: var(--color-userdata);
  }
  .why {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }
  .notes {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
</style>
