---
/**
 * 勉強中の人が書き込み、返信で議論する欄。
 *
 * **なぜ合格報告と別に置くか(ADR-016)**
 * 「危険物乙4 勉強時間」を検索するのは**受験前の人**であり、合格者ではない。
 * 合格報告のフォームしか無かったとき、入口(検索)と出口(投稿)で対象者が
 * 一致しておらず、PVをいくら積んでも投稿の分母が増えない構造だった。
 *
 * **なぜ自由記入だけにしないか**
 * 5ch の資格板を実測したところ、書き込みの約45%は雑談だった。
 * 「何を書いてもいい」欄を置くと、生まれるものの半分は検索で来た人の役に立たない。
 * 起点を「いまの状況 + 詰まっていること」に固定すると、書かれる内容が変わる。
 * **モデレーションで削るのではなく、フォームの形で決める。**
 *
 * **なぜ実行時に取りに行くか**
 * 合格報告はビルド時のスナップショットを埋め込んでいるが、同じ作りだと
 * 書き込んでも次のデプロイまで画面に出ない。「投稿しても何も起きない」は
 * 最初の数人を必ず失う。ここだけは /api/posts から実行時に読む。
 *
 * 0件でもページは成立する。空欄を並べず、何を書けばいいかだけを示す。
 */
interface Props {
  entitySlug: string;
  entityShortName: string;
}
const { entitySlug, entityShortName } = Astro.props;
---

<section class="board" aria-labelledby="h-board" data-slug={entitySlug}>
  <h2 id="h-board">{entityShortName}を勉強している人の書き込み</h2>

  <p class="lede">
    いま詰まっていることや、進み具合を書き残せます。登録は要りません。
    返信もできるので、分かる人が答えられます。
  </p>

  <!-- 一覧。JSが動く前は「読み込み中」を出さない(0件と区別がつかないため) -->
  <div class="list" data-role="list" hidden></div>

  {/*
    **書き込みが増えてもページが伸び続けないようにする。**

    当初この欄は全スレッド・全返信を無条件に描画していた。1件あたり約110pxなので、
    50件たまれば 5,500px、200件で 22,000px がこの節だけで積み上がる。
    資格ページは投稿0件の時点で既に 11,649px(モバイル14.3画面)あり、
    そこに上限の無い領域を置くと、増えるほど読めなくなる作りだった。

    初期表示を絞り、残りは「もっと見る」で足す。返信も同じ扱いにする。
    件数は必ず先に出す(何件あるのか分からないまま畳まれているのが一番不親切)。
  */}
  <p class="board-count" data-role="count" hidden></p>

  <p class="more-wrap" data-role="more-wrap" hidden>
    <button type="button" data-role="more"></button>
  </p>

  <p class="empty" data-role="empty" hidden>
    まだ書き込みはありません。<strong>最初の1件になれます。</strong>
  </p>

  {/*
    **ほかの資格の最近の書き込み(2026-07-28 追加)。**

    この欄は17枚の資格ページすべてに置いてある。投稿の総数が少ないうちは
    **17枚すべてが「まだ書き込みはありません」を出す。**
    投稿という希少な資源を17分割したので、どのページも過疎に見える構造だった。
    最初に来た人には「誰も居ない場所に最初の1件を書け」と言っているのと同じである。

    この資格の書き込みが3件未満のときだけ、他の資格の直近の書き込みを添える。
    **同じ一覧に混ぜない。**資格名を付けて別の見出しの下に出す。
    ここで混ぜると「宅建の書き込み」として他資格の話が読まれてしまう。
  */}
  <section class="elsewhere" data-role="elsewhere" hidden>
    <h3>ほかの資格では、こんな書き込みがあります</h3>
    <ul data-role="elsewhere-list"></ul>
  </section>

  {/*
    **戻り先のURLを必ず出す(2026-07-28)。**
    このサイトはアカウントも通知も持たない。
    分かる人が「どこかに未回答の質問があるはずだ」と思ったとき、
    17枚の資格ページを1枚ずつ開いて確かめる以外の手段が無かった。
    ブックマークできる1つの入口が、唯一の再訪経路になる。
  */}
  <p class="to-all">
    <a href="/board/">すべての資格の書き込みを見る(未回答が先)</a>
  </p>

  <p class="failed" data-role="failed" hidden>
    書き込みを読み込めませんでした。時間をおいて再読み込みしてください。
  </p>

  <form class="composer" data-role="composer" novalidate>
    <fieldset class="tags">
      <legend>いまの状況</legend>
      <label><input type="radio" name="status_tag" value="before" /><span>これから始める</span></label>
      <label><input type="radio" name="status_tag" value="studying" checked /><span>勉強中</span></label>
      <label><input type="radio" name="status_tag" value="taken" /><span>受験済み</span></label>
    </fieldset>

    <label class="field">
      <span class="label">詰まっていること・いまの進み具合</span>
      <textarea name="body" rows="3" maxlength="400" required
        placeholder="例)法令の指定数量でいつも間違えます。表を丸暗記するしかないでしょうか"></textarea>
      <span class="counter" data-role="counter">0 / 400</span>
    </label>

    <label class="field name">
      <span class="label">名前(任意)</span>
      <input type="text" name="handle" maxlength="16" placeholder="名無し" autocomplete="off" />
    </label>

    <!-- ボットだけが埋める。CSSで隠す -->
    <div class="hp" aria-hidden="true">
      <label>website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="actions">
      <button type="submit">書き込む</button>
      <p class="note">
        試験問題そのものは書けません(実施団体に著作権があります)。
        URL・連絡先も投稿できません。
        <a href="/rules/">投稿のルール</a>
      </p>
    </div>

    <p class="result" data-role="result" role="status" hidden></p>
  </form>
</section>

<script>
  /*
   * 表示は全て textContent で行う。**innerHTML は使わない。**
   * 投稿は他人が書いた文字列であり、1箇所でも生のHTMLとして入れると
   * そこがそのままXSSの入口になる。
   */
  const section = document.querySelector<HTMLElement>('.board[data-slug]');
  if (section) {
    const slug = section.dataset.slug!;
    const listEl = section.querySelector<HTMLElement>('[data-role="list"]')!;
    const emptyEl = section.querySelector<HTMLElement>('[data-role="empty"]')!;
    const failedEl = section.querySelector<HTMLElement>('[data-role="failed"]')!;
    const form = section.querySelector<HTMLFormElement>('[data-role="composer"]')!;
    const resultEl = section.querySelector<HTMLElement>('[data-role="result"]')!;
    const counterEl = section.querySelector<HTMLElement>('[data-role="counter"]')!;
    const countEl = section.querySelector<HTMLElement>('[data-role="count"]')!;
    const moreWrapEl = section.querySelector<HTMLElement>('[data-role="more-wrap"]')!;
    const moreEl = section.querySelector<HTMLButtonElement>('[data-role="more"]')!;
    const bodyEl = form.elements.namedItem('body') as HTMLTextAreaElement;
    const loadedAt = Date.now();

    /**
     * 一度に出すスレッド数と、スレッド1本あたりに最初から開いておく返信数。
     *
     * 5 と 2 の根拠は「初期表示をこの節1つで1画面に収める」こと。
     * スレッド1本が約110px、返信1本が約70pxなので、5本 + 返信2本ずつで
     * 概ね 800px 前後に収まる。**上限を持たない設計にしないことが要点**であり、
     * この数字自体は実際の投稿が集まってから調整してよい。
     */
    const PAGE_SIZE = 5;
    const REPLIES_SHOWN = 2;

    let threads: Post[] = [];
    let rendered = 0;

    const show = (el: HTMLElement, on: boolean) => {
      el.hidden = !on;
    };

    /** 「3分前」「昨日」。秒までは出さない(投稿者の行動時刻を細かく晒さない) */
    function ago(iso: string): string {
      const diff = (Date.now() - Date.parse(iso)) / 1000;
      if (!Number.isFinite(diff)) return '';
      if (diff < 60) return 'たった今';
      if (diff < 3600) return `${Math.floor(diff / 60)}分前`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}時間前`;
      if (diff < 86400 * 7) return `${Math.floor(diff / 86400)}日前`;
      return iso.slice(0, 10);
    }

    interface Post {
      id: number;
      handle: string | null;
      body: string;
      statusLabel: string | null;
      createdAt: string;
      replies?: Post[];
    }

    function renderPost(post: Post, isReply: boolean): HTMLElement {
      const article = document.createElement('article');
      article.className = isReply ? 'post reply' : 'post';

      const head = document.createElement('p');
      head.className = 'meta';
      const name = document.createElement('span');
      name.className = 'who';
      name.textContent = post.handle ?? '名無し';
      head.append(name);
      if (post.statusLabel) {
        const tag = document.createElement('span');
        tag.className = 'tag';
        tag.textContent = post.statusLabel;
        head.append(tag);
      }
      const time = document.createElement('time');
      time.dateTime = post.createdAt;
      time.textContent = ago(post.createdAt);
      head.append(time);

      const body = document.createElement('p');
      body.className = 'body';
      body.textContent = post.body;

      article.append(head, body);

      if (!isReply) {
        const replies = document.createElement('div');
        replies.className = 'replies';
        const all = post.replies ?? [];
        /* 返信も上限を持たせる。議論が伸びたスレッドが1本でページを支配しないように */
        for (const r of all.slice(0, REPLIES_SHOWN)) replies.append(renderPost(r, true));
        article.append(replies);

        /*
         * **まだ誰も答えていない印(2026-07-28)。**
         *
         * この欄は「詰まっている勉強中の人」だけを集める作りで、
         * **答える側が動く理由をどこにも用意していなかった。**
         * 投稿が増えれば、未回答の質問が並ぶだけの場所になる。
         * どれが未回答かが一目で分かれば、分かる人が拾える。
         */
        if (all.length === 0) {
          const flag = document.createElement('p');
          flag.className = 'unanswered';
          flag.textContent = 'まだ誰も答えていません';
          head.after(flag);
        }

        const hidden = all.length - REPLIES_SHOWN;
        if (hidden > 0) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'more-replies';
          btn.textContent = `返信をあと${hidden}件表示`;
          btn.addEventListener('click', () => {
            for (const r of all.slice(REPLIES_SHOWN)) replies.append(renderPost(r, true));
            btn.remove();
          });
          article.append(btn);
        }

        article.append(buildReplyForm(post.id, replies));
      }
      return article;
    }

    function buildReplyForm(parentId: number, mount: HTMLElement): HTMLElement {
      const wrap = document.createElement('details');
      wrap.className = 'reply-form';
      const summary = document.createElement('summary');
      summary.textContent = '返信する';
      const f = document.createElement('form');
      const ta = document.createElement('textarea');
      ta.rows = 2;
      ta.maxLength = 400;
      ta.required = true;
      ta.placeholder = '分かることがあれば書いてください';
      const btn = document.createElement('button');
      btn.type = 'submit';
      btn.textContent = '返信';
      const msg = document.createElement('p');
      msg.className = 'result';
      msg.setAttribute('role', 'status');
      f.append(ta, btn, msg);
      wrap.append(summary, f);

      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        const res = await send({
          entity_slug: slug,
          kind: 'reply',
          parent_id: parentId,
          body: ta.value,
          form_loaded_at: loadedAt,
        });
        msg.textContent = res.message;
        if (res.ok && res.post) {
          mount.append(renderPost(res.post, true));
          ta.value = '';
        }
        btn.disabled = false;
      });
      return wrap;
    }

    async function send(payload: Record<string, unknown>): Promise<{
      ok: boolean;
      message: string;
      post?: Post;
    }> {
      try {
        const r = await fetch('/api/post', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await r.json();
        if (!r.ok || !data.ok) {
          return { ok: false, message: data.message ?? '書き込めませんでした' };
        }
        if (data.status === 'pending') return { ok: false, message: data.message };
        return { ok: true, message: '書き込みました', post: data.post };
      } catch {
        return { ok: false, message: '通信できませんでした。時間をおいて試してください' };
      }
    }

    /** 次の PAGE_SIZE 件を一覧に足す。**既に出したものは作り直さない** */
    function renderMore() {
      const next = threads.slice(rendered, rendered + PAGE_SIZE);
      for (const t of next) listEl.append(renderPost(t, false));
      rendered += next.length;
      paintControls();
    }

    /** 件数表示と「もっと見る」の状態を、いまの描画数から組み立て直す */
    function paintControls() {
      const total = threads.length;
      show(listEl, rendered > 0);
      show(emptyEl, total === 0);

      countEl.textContent = total === 0 ? '' : `${total}件中 ${rendered}件を表示`;
      show(countEl, total > PAGE_SIZE);

      const remaining = total - rendered;
      moreEl.textContent =
        remaining > PAGE_SIZE ? `次の${PAGE_SIZE}件を表示(残り${remaining}件)` : `残り${remaining}件を表示`;
      show(moreWrapEl, remaining > 0);
    }

    moreEl.addEventListener('click', renderMore);

    interface Elsewhere {
      id: number;
      handle: string | null;
      body: string;
      createdAt: string;
      slug: string;
      name: string;
    }

    /**
     * ほかの資格の直近の書き込み。
     * **本文は1行に切る。**ここは「この場所は動いている」を伝えるためのもので、
     * 他資格の議論を読ませる場所ではない。読みたければリンク先に行ってもらう。
     */
    function renderElsewhere(items: Elsewhere[]) {
      const wrap = section.querySelector<HTMLElement>('[data-role="elsewhere"]')!;
      const list = section.querySelector<HTMLElement>('[data-role="elsewhere-list"]')!;
      if (!items.length) {
        show(wrap, false);
        return;
      }
      list.replaceChildren(
        ...items.map((it) => {
          const li = document.createElement('li');

          const a = document.createElement('a');
          a.href = `/shikaku/${it.slug}/#board`;
          a.className = 'elsewhere-name';
          a.textContent = it.name;

          const body = document.createElement('span');
          body.className = 'elsewhere-body';
          body.textContent = it.body;

          const time = document.createElement('time');
          time.dateTime = it.createdAt;
          time.className = 'elsewhere-time';
          time.textContent = ago(it.createdAt);

          li.append(a, body, time);
          return li;
        }),
      );
      show(wrap, true);
    }

    async function load() {
      try {
        const r = await fetch(`/api/posts?slug=${encodeURIComponent(slug)}`);
        const data = await r.json();
        if (!r.ok || !data.ok) throw new Error('failed');
        threads = data.threads as Post[];
        rendered = 0;
        listEl.replaceChildren();
        renderMore();
        renderElsewhere(data.elsewhere ?? []);
      } catch {
        show(failedEl, true);
      }
    }

    bodyEl.addEventListener('input', () => {
      counterEl.textContent = `${[...bodyEl.value].length} / 400`;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      const data = new FormData(form);
      const res = await send({
        entity_slug: slug,
        kind: 'thread',
        status_tag: data.get('status_tag'),
        handle: data.get('handle'),
        body: data.get('body'),
        website: data.get('website'),
        form_loaded_at: loadedAt,
      });
      resultEl.textContent = res.message;
      show(resultEl, true);
      if (res.ok && res.post) {
        /* 自分の書き込みは必ず先頭に出す。上限に隠されて「書けたのか分からない」を作らない */
        threads.unshift(res.post);
        rendered++;
        listEl.prepend(renderPost(res.post, false));
        paintControls();
        bodyEl.value = '';
        counterEl.textContent = '0 / 400';
      }
      btn.disabled = false;
    });

    load();
  }
</script>

<style>
  /*
   * 面と枠は、この節を包む [data-source] が持つ(global.css)。
   * ここで箱を描くと二重枠になり、実測で左右48px・上下48pxを無駄にしていた。
   * **箱を描く場所は1つに保つ。**
   */
  .board {
    padding: 0;
  }
  .lede {
    margin: 0 0 var(--space-4);
    line-height: var(--lh-normal);
  }
  .list {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .board-count {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* まだ誰も答えていない印。答える側が拾える場所を見つけるための目印 */
  .board :global(.unanswered) {
    display: inline-block;
    margin: 0 0 var(--space-2);
    padding: 0 var(--space-2);
    font-size: var(--fs-2xs);
    color: var(--color-accent);
    border: 1px dashed var(--color-accent);
    border-radius: var(--radius-pill);
  }

  .to-all {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-sm);
  }

  /* ほかの資格の書き込み。**この資格の一覧とは別の見出しの下に置く** */
  .elsewhere {
    margin: var(--space-5) 0;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
  }
  .elsewhere h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .elsewhere ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .elsewhere li {
    display: grid;
    gap: 0.15rem;
    font-size: var(--fs-xs);
  }
  .elsewhere :global(.elsewhere-name) {
    font-weight: var(--fw-bold);
  }
  /* 本文は1行で切る。ここは賑わいを伝える場所で、読ませる場所ではない */
  .elsewhere :global(.elsewhere-body) {
    color: var(--color-text-muted);
    line-height: var(--lh-heading);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .elsewhere :global(.elsewhere-time) {
    color: var(--color-text-faint);
  }
  .more-wrap {
    margin: 0 0 var(--space-5);
  }
  .more-wrap button {
    width: 100%;
    min-height: 44px;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--color-link);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .more-wrap button:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }
  .board :global(.more-replies) {
    margin-top: var(--space-2);
    padding: var(--space-2) 0;
    min-height: 44px;
    font: inherit;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .board :global(.more-replies):hover {
    color: var(--color-link);
  }
  .empty,
  .failed {
    margin: 0 0 var(--space-5);
    padding: var(--space-4);
    background: var(--color-notice-bg);
    border-radius: var(--radius-sm);
    line-height: var(--lh-normal);
  }
  .board :global(.post) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .board :global(.post.reply) {
    border: 0;
    border-left: 3px solid var(--color-border);
    border-radius: 0;
    margin-top: var(--space-3);
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
  }
  .board :global(.meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .board :global(.who) {
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }
  .board :global(.tag) {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .board :global(.body) {
    margin: 0;
    line-height: var(--lh-normal);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .board :global(.replies) {
    margin-top: var(--space-2);
  }
  .board :global(.reply-form) {
    margin-top: var(--space-3);
    font-size: var(--fs-xs);
  }
  .board :global(.reply-form summary) {
    cursor: pointer;
    color: var(--color-text-muted);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .board :global(.reply-form textarea) {
    width: 100%;
    margin: var(--space-2) 0;
