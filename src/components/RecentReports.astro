---
/**
 * 直近の合格報告(個別)。**1件目から表示する。**
 *
 * **なぜ統計と分けるのか**
 * 中央値や分布は n<20 では出さない。1件増えるだけで数字が跳ね、
 * 読む人に誤った基準を渡すからである(この方針は変えない)。
 *
 * だが「2025年合格・独学・80時間」という**1人の記録は集計値ではない**。
 * 1件目から出しても誤解は生まれないし、むしろ
 * 「ここには人がいる」ことが伝わる唯一の手段である。
 *
 * 当初この2つを区別せず、個別の報告まで20件まで隠していた。
 * その設計は**最初の19人に「投稿しても何も起きない」と伝えている**のと同じだった。
 * 外部評価で指摘されて気づいた(2026-07-26)。
 *
 * 投稿ゼロのときは、空欄を並べずに「まだ0件」と正直に書き、投稿を促す。
 */
import type { ReportSnapshot } from '../lib/reportSummary';

interface Props {
  snapshot: ReportSnapshot;
  entityShortName: string;
}
const { snapshot, entityShortName } = Astro.props;

const reports = snapshot.recent ?? [];
const n = snapshot.totalReports;
---

<section class="recent" aria-labelledby="h-recent" data-user-data-note>
  <h2 id="h-recent">合格した人の記録</h2>

  {reports.length === 0 ? (
    <div class="empty">
      <p class="empty-lead">
        {entityShortName}の合格報告は<strong>まだ0件</strong>です。
      </p>
      <p>
        最初の1件を送ってもらえると、ここに表示されます。
        「何時間で受かったか」は公式発表には載っていない、合格した人しか持っていない情報です。
      </p>
      <p><a class="cta" href="#report">合格報告を送る(3項目・30秒)</a></p>
    </div>
  ) : (
    <>
      <p class="lead">
        これまでに寄せられた<strong>{n}件</strong>のうち、直近{reports.length}件を表示しています。
        <strong>すべて自己申告</strong>で、公的な統計ではありません。
      </p>
      <ul class="list">
        {reports.map((r) => (
          <li class="item">
            <p class="head">
              <span class="year">{r.passedYear}年合格</span>
              <span class="hours">{r.studyHours}時間</span>
              <span class="attempts">{r.attempts}回目</span>
            </p>
            {r.material && <p class="material">教材: {r.material}</p>}
            {r.note && <p class="note">{r.note}</p>}
          </li>
        ))}
      </ul>
      <p class="foot">
        件数が少ないうちは、この記録から全体の傾向を読み取ることはできません。
        中央値や分布は20件に達してから表示します。
      </p>
      <p><a class="cta" href="#report">自分の記録も送る(3項目・30秒)</a></p>
    </>
  )}
</section>

<style>
  .recent {
    margin-top: var(--space-7);
  }
  .empty,
  .lead {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-userdata);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-userdata-bg);
    padding: var(--space-4);
  }
  .empty p,
  .lead {
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-3);
  }
  .empty p:last-child,
  .lead {
    margin-bottom: 0;
  }
  .empty-lead {
    font-size: var(--fs-lg);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-3);
  }
  .item {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-userdata);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: var(--space-3) var(--space-4);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .hours {
    font-weight: var(--fw-bold);
    font-size: var(--fs-lg);
  }
  .year,
  .attempts {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .material,
  .note {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  .note {
    color: var(--color-text-muted);
  }
  .foot {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin-top: var(--space-3);
  }
  /* タップ目標44px。押せない導線は無いのと同じ */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    margin-top: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--color-userdata);
    color: #fff;
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
    text-decoration: none;
  }
</style>
